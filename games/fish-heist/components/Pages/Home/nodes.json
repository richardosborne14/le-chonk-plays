{
  "$schema": "https://opennoodl.dev/schemas/nodes-v2.json",
  "componentId": "328c07e8-a645-5a8a-881d-446f13df7e98",
  "version": 1,
  "nodes": [
    {
      "id": "home_page",
      "type": "Page",
      "label": "Home page",
      "children": [
        "home_layout"
      ],
      "parameters": {
        "title": "Le Chonk's Fish Heist",
        "urlPath": "home"
      },
      "x": 40,
      "y": 40
    },
    {
      "id": "home_layout",
      "type": "Group",
      "label": "Centered column",
      "parent": "home_page",
      "children": [
        "home_icon",
        "home_title",
        "home_prompt",
        "home_namefield",
        "home_play"
      ],
      "parameters": {
        "width": {
          "value": 100,
          "unit": "%"
        },
        "maxWidth": {
          "value": 480,
          "unit": "px"
        },
        "flexDirection": "column",
        "alignItems": "center",
        "rowGap": "var(--space-6)",
        "paddingTop": "var(--space-16)",
        "paddingBottom": "var(--space-16)",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)"
      },
      "x": 100,
      "y": 160
    },
    {
      "id": "home_title",
      "type": "Text",
      "label": "Game title",
      "parent": "home_layout",
      "parameters": {
        "text": "Le Chonk's Fish Heist",
        "fontSize": "var(--display-md)",
        "fontWeight": "var(--font-bold)",
        "lineHeight": "var(--leading-none)",
        "letterSpacing": "var(--tracking-tighter)",
        "textAlignX": "center",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 280
    },
    {
      "id": "home_prompt",
      "type": "Text",
      "label": "Who's playing? prompt",
      "parent": "home_layout",
      "parameters": {
        "text": "Who's playing?",
        "fontSize": "var(--text-xl)",
        "fontWeight": "var(--font-semibold)",
        "textAlignX": "center",
        "color": "var(--foreground)"
      },
      "x": 160,
      "y": 400
    },
    {
      "id": "home_namefield",
      "type": "net.noodl.controls.textinput",
      "label": "Name field",
      "parent": "home_layout",
      "parameters": {
        "placeholder": "Your name",
        "sizeMode": "contentHeight",
        "width": {
          "value": 100,
          "unit": "%"
        },
        "type": "text",
        "backgroundColor": "var(--background)",
        "color": "var(--foreground)",
        "fontSize": "var(--text-base)",
        "borderStyle": "solid",
        "borderWidth": "var(--border-1)",
        "borderColor": "var(--border-control)",
        "borderRadius": "var(--radius-md)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "paddingLeft": "var(--space-3)",
        "paddingRight": "var(--space-3)"
      },
      "x": 160,
      "y": 520
    },
    {
      "id": "home_play",
      "type": "net.noodl.controls.button",
      "label": "Play button",
      "parent": "home_layout",
      "parameters": {
        "label": "Play",
        "backgroundColor": "var(--primary)",
        "color": "var(--primary-foreground)",
        "borderRadius": "var(--radius-full)",
        "borderStyle": "none",
        "paddingLeft": "var(--space-6)",
        "paddingRight": "var(--space-6)",
        "paddingTop": "var(--space-3)",
        "paddingBottom": "var(--space-3)",
        "fontSize": "var(--text-sm)",
        "fontWeight": "var(--font-semibold)",
        "sizeMode": "contentSize"
      },
      "x": 160,
      "y": 640
    },
    {
      "id": "player_name",
      "type": "Variable2",
      "label": "Player name, app-wide",
      "x": 40,
      "y": 160,
      "parameters": {
        "name": "playerName"
      }
    },
    {
      "id": "home_icon",
      "type": "net.noodl.visual.icon",
      "label": "Le Chonk glyph",
      "parent": "home_layout",
      "parameters": {
        "iconSourceType": "icon",
        "iconIconSource": {
          "class": "lucide",
          "code": "icon-cat",
          "codeAsClass": true
        },
        "iconColor": "var(--amber-500)",
        "iconSize": 56
      },
      "x": 160,
      "y": 760
    },
    {
      "id": "go_to_game",
      "type": "RouterNavigate",
      "label": "Open the game",
      "x": 40,
      "y": 140,
      "parameters": {
        "router": "Main",
        "target": "/Pages/Game"
      }
    }
  ],
  "visualRoots": [
    "home_page"
  ]
}