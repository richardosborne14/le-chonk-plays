    {
      "id": "gameStep",
      "type": "JavaScriptFunction",
      "label": "One tap on the board: validate, move Le Chonk, step the dog, end the round",
      "x": 600,
      "y": 40,
      "parameters": {
        "functionScript": "if (Inputs.col === undefined || Inputs.row === undefined) return;\n\nconst CRATES = [[2, 2], [6, 2], [4, 3], [2, 5], [4, 5], [6, 6]];\nconst FISH_COL = 7;\nconst FISH_ROW = 1;\n\nconst isCrate = (col, row) => CRATES.some((c) => c[0] === col && c[1] === row);\n\nconst saveTally = (won, lost) => {\n  localStorage.setItem(\"lechonk_tally\", JSON.stringify({ won: won, lost: lost }));\n};\n\n// One step towards Le Chonk: along the axis with the bigger gap (across when\n// the gaps are equal), the other axis when that square is a crate or the gap\n// is 0, staying put when both are blocked.\nconst dogStep = (fromCol, fromRow, toCol, toRow) => {\n  const dCol = toCol - fromCol;\n  const dRow = toRow - fromRow;\n  const axes = Math.abs(dCol) >= Math.abs(dRow) ? [\"across\", \"updown\"] : [\"updown\", \"across\"];\n  for (const axis of axes) {\n    if (axis === \"across\" && dCol !== 0) {\n      const nextCol = fromCol + (dCol > 0 ? 1 : -1);\n      if (!isCrate(nextCol, fromRow)) return [nextCol, fromRow];\n    }\n    if (axis === \"updown\" && dRow !== 0) {\n      const nextRow = fromRow + (dRow > 0 ? 1 : -1);\n      if (!isCrate(fromCol, nextRow)) return [fromCol, nextRow];\n    }\n  }\n  return [fromCol, fromRow];\n};\n\nlet catCol = Inputs.catCol;\nlet catRow = Inputs.catRow;\nlet dogCol = Inputs.dogCol;\nlet dogRow = Inputs.dogRow;\nlet moves = Inputs.moves;\nlet message = Inputs.message;\nlet gameOver = Inputs.gameOver;\nlet tallyWon = Inputs.tallyWon;\nlet tallyLost = Inputs.tallyLost;\n\nif (!gameOver) {\n  const tapCol = Inputs.col;\n  const tapRow = Inputs.row;\n  const dCol = tapCol - catCol;\n  const dRow = tapRow - catRow;\n  const onBoard = tapCol >= 1 && tapCol <= 7 && tapRow >= 1 && tapRow <= 7;\n  const nextToCat = Math.abs(dCol) + Math.abs(dRow) === 1;\n  if (nextToCat && onBoard && !isCrate(tapCol, tapRow)) {\n    catCol = tapCol;\n    catRow = tapRow;\n    moves = moves + 1;\n    message = \"\";\n    if (catCol === FISH_COL && catRow === FISH_ROW) {\n      gameOver = true;\n      message = \"Le Chonk got the fish! 🐟\";\n      tallyWon = tallyWon + 1;\n      saveTally(tallyWon, tallyLost);\n    } else if (catCol === dogCol && catRow === dogRow) {\n      gameOver = true;\n      message = \"Caught! The dog wins.\";\n      tallyLost = tallyLost + 1;\n      saveTally(tallyWon, tallyLost);\n    } else {\n      const next = dogStep(dogCol, dogRow, catCol, catRow);\n      dogCol = next[0];\n      dogRow = next[1];\n      if (dogCol === catCol && dogRow === catRow) {\n        gameOver = true;\n        message = \"Caught! The dog wins.\";\n        tallyLost = tallyLost + 1;\n        saveTally(tallyWon, tallyLost);\n      }\n    }\n  } else {\n    message = \"Le Chonk can only move one square\";\n  }\n}\n\nOutputs.catCol = catCol;\nOutputs.catRow = catRow;\nOutputs.dogCol = dogCol;\nOutputs.dogRow = dogRow;\nOutputs.moves = moves;\nOutputs.message = message;\nOutputs.gameOver = gameOver;\nOutputs.tallyWon = tallyWon;\nOutputs.tallyLost = tallyLost;",
        "runOnChange-in-col": false,
        "runOnChange-in-row": false,
        "runOnChange-in-catCol": false,
        "runOnChange-in-catRow": false,
        "runOnChange-in-dogCol": false,
        "runOnChange-in-dogRow": false,
        "runOnChange-in-moves": false,
        "runOnChange-in-gameOver": false,
        "runOnChange-in-tallyWon": false,
        "runOnChange-in-tallyLost": false
      },
      "ports": [
        {
          "name": "in-col",
          "displayName": "col",
          "plug": "input",
          "type": "*",
          "group": "Inputs"
        },
