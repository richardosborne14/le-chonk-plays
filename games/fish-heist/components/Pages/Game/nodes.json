    {
      "id": "loadTally",
      "type": "JavaScriptFunction",
      "label": "Read the Won/Lost tally from this device",
      "x": 600,
      "y": 560,
      "parameters": {
        "functionScript": "let won = 0;\nlet lost = 0;\ntry {\n  const parsed = JSON.parse(localStorage.getItem(\"lechonk_tally\") || \"{}\");\n  won = parsed.won || 0;\n  lost = parsed.lost || 0;\n} catch (error) {\n  won = 0;\n  lost = 0;\n}\nOutputs.won = won;\nOutputs.lost = lost;"
      },
      "ports": [
        {
          "name": "out-won",
          "displayName": "won",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        },
        {
          "name": "out-lost",
          "displayName": "lost",
          "plug": "output",
          "type": "*",
          "group": "Outputs"
        }
      ]
    },
